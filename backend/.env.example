# Copy to .env and adjust. Never commit .env.

DATABASE_URL=postgresql+psycopg://custodian:custodian@localhost:5432/custodian
TEST_DATABASE_URL=postgresql+psycopg://custodian:custodian@localhost:5432/custodian_test

# Minutes a cached price quote stays fresh before the feed is re-polled.
QUOTE_TTL_MINUTES=15

# Which origins may call the API. The front end is a separate service on its own
# port, so every browser request to this one is cross-origin. Matching the port
# on any host covers localhost, the Pi's LAN address and a Tailscale name.
# Widen to http(s)?://[^/]+:5173 while rolling out Tailscale HTTPS (see
# DEPLOY.md's "Plaid bank sync" section) so both schemes work during the switch.
CORS_ORIGIN_REGEX=http://[^/]+:5173

# Plaid bank sync (optional — the app runs fine without it, see DEPLOY.md).
# Client id/secret come from the Plaid dashboard once Production access is
# approved; sandbox works with any sandbox app's credentials for local testing.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Must exactly match a redirect URI registered in the Plaid dashboard, and
# must be HTTPS for Chase's OAuth handoff — see the Tailscale HTTPS step in
# DEPLOY.md. Leave blank until that's set up; sandbox testing doesn't need it.
PLAID_REDIRECT_URI=
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means re-linking, not decrypting old data — there is no
# rotation tooling.
PLAID_TOKEN_ENCRYPTION_KEY=
